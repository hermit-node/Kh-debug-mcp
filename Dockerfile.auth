# Separate Rust Auth Server image. Does not publish StegoSplit binaries.
FROM rust:1-bookworm AS build
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src/ ./src/
COPY assets/ ./assets/
RUN cargo build --locked --release --bin kh-debug-auth --bin kh-debug-pairgen -j 2

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10002 --create-home khauth \
    && mkdir -p /auth/state /auth/pair /provision/auth /provision/mcp /provision/state \
    && chown -R 10002:10002 /auth /provision
COPY --from=build /build/target/release/kh-debug-auth /usr/local/bin/kh-debug-auth
COPY --from=build /build/target/release/kh-debug-pairgen /usr/local/bin/kh-debug-pairgen
USER 10002:10002
ENV KH_AUTH_BIND=0.0.0.0:41371 KH_AUTH_STATE_DIR=/auth/state
WORKDIR /home/khauth
EXPOSE 41371
ENTRYPOINT ["/usr/local/bin/kh-debug-auth"]
